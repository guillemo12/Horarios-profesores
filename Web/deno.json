{
  "imports": {
    "@std/http/file-server": "jsr:@std/http/file-server@^0.224.0",
    "esbuild": "npm:esbuild@^0.20.2"
  },
  "tasks": {
    "bundle": "deno run -A npm:esbuild Web/src/Datos.ts --bundle --outfile=src/main/resources/static/Datos.js --format=iife",
    "dev": "deno run --allow-net --allow-read jsr:@std/http/file-server src/main/resources/static --port 8080",
    "tauri": "deno run -A npm:@tauri-apps/cli"
  }
}