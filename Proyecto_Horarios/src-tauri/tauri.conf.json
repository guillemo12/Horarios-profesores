{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduSchedule",
  "version": "0.0.10",
  "identifier": "com.guill.eduschedule",
  "build": {
    "frontendDist": "../../src/main/resources/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EduSchedule",
        "width": 1200,
        "height": 800,
        "url": "index.html",
        "visible": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "EduSchedule School Timetable Management",
    "longDescription": "EduSchedule School Timetable and Teachers Management System",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
