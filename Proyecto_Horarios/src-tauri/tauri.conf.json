{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduSchedule",
  "version": "0.0.3",
  "identifier": "com.guill.eduschedule",
  "build": {
    "devUrl": "http://localhost:8080",
    "frontendDist": "../../src/main/resources/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EduSchedule",
        "width": 1200,
        "height": 800,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "backend_ktor/**/*"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
